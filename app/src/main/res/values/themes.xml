<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      公共外观 (所有 Android 版本共用)。
      固定为深色主题 (不再用 DayNight 跟随系统), 因为整个 App 采用深色背景;
      并显式声明浅色文字, 确保任何系统日夜模式下都是"浅字深底", 不会出现深字深底。
    -->
    <style name="Base.Theme.FitsViewer" parent="Theme.MaterialComponents">
        <item name="colorPrimary">#263238</item>
        <item name="colorPrimaryVariant">#1C262B</item>
        <item name="colorOnPrimary">#ECEFF1</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">#0288D1</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- 背景 / 表面 及其上的文字色, 保证对比度 -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/panel_dark</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- 默认正文/次要文字色 (列表项、下拉框、对话框等未显式着色的文字都取这里) -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColor">@color/text_primary</item>

        <!-- 统一系统栏配色, 避免不同手机默认色差异 -->
        <item name="android:statusBarColor">#1C262B</item>
        <item name="android:navigationBarColor">#102027</item>
    </style>

    <style name="Theme.FitsViewer" parent="Base.Theme.FitsViewer" />
</resources>
